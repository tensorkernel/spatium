# Per 02-SYSTEM-ARCHITECTURE.md §2.6 and 18-CI-CD-RELEASE-PIPELINE.md §18.2.

# === Rust ===
/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# === Node / pnpm ===
/node_modules/
/apps/*/node_modules/
/packages/*/node_modules/
/crates/*/node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-error.log*
.pnpm-store/

# === Build outputs ===
/dist/
**/dist/
/Release/
*.exe
*.dll
*.node
*.msi
*.msix
*.appx
*.dmg
*.deb
*.AppImage

# === Electron specific ===
/apps/desktop/out/
/apps/desktop/release/
/apps/desktop/.vite/

# === Rust native module (napi-rs) ===
# The .node binary is auto-generated by `napi build` and platform-specific — never commit.
/crates/napi/*.node
# The index.js is also auto-generated (but the stub version IS committed so Node can
# gracefully fall back to Mock IPC mode when the .node binary hasn't been built).
# (We commit a stub index.js + the full index.d.ts so typecheck works in CI without
# having to run the napi build first.)

# === IDE / OS ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# === Logs ===
*.log
logs/

# === Test / coverage ===
coverage/
.nyc_output/
*.lcov
.tarpaulin/

# === Secrets (per 15-SECURITY-ARCHITECTURE.md §15.10: never commit secrets) ===
*.env
.env.local
.env.*.local
secrets/
*.pem
*.key
*.der
# Dev licensing keys are auto-generated on first run by loadOrGenerateDevKeys()
# (per 13-LICENSING-SERVER.md §13.5 + apps/licensing-server/src/keys.ts).
# Do NOT commit them — even dev keys should not be in a public repo.
apps/licensing-server/src/keys/

# === User-specific runtime data ===
.spatium/

# === Cache ===
.cache/
.eslintcache
.biome-cache
apps/desktop/index.js

# === Large build artifacts (exceed GitHub's 100 MB file limit) ===
*.zip
download/
upload/
