# EditorConfig per 18-CI-CD-RELEASE-PIPELINE.md §4.2 deliverables.
# Helps maintain consistent indentation and line endings across editors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
