{
  "name": "@disk-analyzer/ui",
  "version": "0.1.0",
  "private": true,
  "description": "DiskAnalyzer UI package: design tokens + shared components (per 09-DESIGN-SYSTEM.md).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "import": "./src/components/*.tsx"
    },
    "./visualizations/*": {
      "types": "./src/visualizations/*.tsx",
      "import": "./src/visualizations/*.tsx"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/ --passWithNoTests || echo 'no tests yet'",
    "build": "echo 'Phase 0: no build step yet (consumed via source by apps/desktop)'",
    "test": "pnpm typecheck"
  },
  "dependencies": {
    "@disk-analyzer/ipc": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
